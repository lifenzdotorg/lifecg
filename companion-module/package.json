{
	"name": "lifenz-lifecg",
	"version": "1.3.0",
	"description": "Bitfocus Companion module for LIFENZ LifeCG.app (speaker-title lower thirds over Syphon)",
	"main": "dist/main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"package": "npm run build && companion-module-build",
		"test": "tsc -p tsconfig.json && vitest run",
		"mock-server": "node test/mock-server.mjs"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lifenzdotorg/lifecg.git"
	},
	"engines": {
		"node": "^22.20"
	},
	"dependencies": {
		"@companion-module/base": "~2.0.4",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@companion-module/tools": "~3.0.2",
		"@types/node": "^22.19.17",
		"@types/ws": "^8.18.1",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"vitest": "^5.1.0"
	}
}
